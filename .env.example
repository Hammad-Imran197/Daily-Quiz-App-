# Optional environment variables for Daily Quiz
# Copy to .env only if you want to customize — the app runs fine with NONE of these.

# ---- AI-generated quizzes (free tier) ----
# Get a free key at https://aistudio.google.com/apikey (Google AI Studio).
# Without a key, the app uses the built-in question bank (works fully offline).
GEMINI_API_KEY=
# Optional model override (default: gemini-2.0-flash)
GEMINI_MODEL=

# ---- Server ----
# Port for the web server (default 3000)
PORT=3000

# ---- Push notifications ----
# VAPID keys are auto-generated into data/vapid.json on first run.
# Set these only if you manage keys yourself (e.g. for a shared deployment).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact address advertised to push services (default: mailto:admin@localhost)
VAPID_SUBJECT=mailto:you@example.com
